# Local Docker Compose development settings. This file contains only
# development-only credentials; `make init` copies it to the ignored .env.
POSTGRES_DB=adp
POSTGRES_USER=adp
POSTGRES_PASSWORD=adp-dev-password
ADP_DB_DSN=postgres://adp:adp-dev-password@postgres:5432/adp?sslmode=disable

ADP_AUTH_ADMIN_USERNAME=admin
ADP_AUTH_ADMIN_PASSWORD=adp-dev-admin-password
ADP_AUTH_SECRET=adp-dev-jwt-signing-secret-change-before-sharing
ADP_AUTH_WORKER_TOKEN=adp-dev-worker-token-change-before-sharing

# Host ports, allowing multiple local stacks to coexist when needed.
ADP_HTTP_PORT=18080
ADP_GRPC_PORT=19090

# LLM is optional for local development. Set all three to enable Agent calls.
ADP_AGENT_BASE_URL=
ADP_AGENT_API_KEY=
ADP_AGENT_MODEL=

# RAG is disabled by default. Enable it only after providing a compatible
# embeddings endpoint and credentials. The Compose PostgreSQL image includes
# pgvector, so no additional database component is needed.
ADP_RAG_ENABLED=false
ADP_RAG_EMBEDDING_BASE_URL=
ADP_RAG_EMBEDDING_API_KEY=
ADP_RAG_EMBEDDING_MODEL=
ADP_RAG_EMBEDDING_DIMENSIONS=1024
