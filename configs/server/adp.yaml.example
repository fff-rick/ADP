addr: ":8080"

worker:
  grpc_addr: ":9090"

db:
  dsn: ""

auth:
  admin_username: "admin"
  admin_password: "<set-in-secret-manager>"
  secret: "<set-in-secret-manager>"
  worker_token: "<set-in-secret-manager>"

agent:
  base_url: ""
  api_key: ""
  model: "gpt-4"
  max_steps: 20
  # Set these from the deployed model's current pricing; zero disables cost estimation.
  input_token_cost_usd_per_1k: 0
  output_token_cost_usd_per_1k: 0
