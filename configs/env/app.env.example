ADP_SERVER_ADDR=:8080
ADP_WORKER_GRPC_ADDR=:9090
ADP_AUTH_SECRET=<set-in-secret-manager>
ADP_ADMIN_USERNAME=admin
ADP_ADMIN_PASSWORD=<set-in-secret-manager>
# Server: ADP_AUTH_WORKER_TOKEN; standalone Worker: ADP_WORKER_TOKEN.
ADP_AUTH_WORKER_TOKEN=<set-in-secret-manager>
ADP_WORKER_TOKEN=<set-in-secret-manager>
ADP_SERVER_URL=http://127.0.0.1:8080
ADP_GRPC_SERVER_ADDR=127.0.0.1:9090
ADP_WORKER_NAME=worker-1
ADP_WORKER_TYPE=shell
ADP_WORKER_POLL_INTERVAL=5s
ADP_SERVICES_CONFIG=/etc/adp/services.cnf
# Agent 模型配置（OpenAI-compatible tool calling API）
ADP_AGENT_BASE_URL=https://api.openai.com/v1
ADP_AGENT_API_KEY=<set-in-secret-manager>
ADP_AGENT_MODEL=gpt-4
ADP_AGENT_MAX_STEPS=12
# Set this to the exact provider/model context window before enforcing the
# server-side budget. A zero value records estimates without rejecting calls.
ADP_AGENT_CONTEXT_WINDOW_TOKENS=65536
ADP_AGENT_RESERVED_OUTPUT_TOKENS=4096
ADP_AGENT_CONTEXT_HARD_USAGE_RATIO=0.80
ADP_AGENT_TOOL_EVIDENCE_MAX_TOKENS=600
# Compare baseline and compacted context without changing the live request.
ADP_AGENT_CONTEXT_SHADOW_ENABLED=false
# RAG embedding configuration. Enable only after PostgreSQL is running with
# pgvector and approved cases have passed the human review gate.
ADP_RAG_ENABLED=false
ADP_RAG_EMBEDDING_BASE_URL=https://api.openai.com/v1
ADP_RAG_EMBEDDING_API_KEY=<set-in-secret-manager>
ADP_RAG_EMBEDDING_MODEL=text-embedding-3-small
ADP_RAG_EMBEDDING_DIMENSIONS=1024
